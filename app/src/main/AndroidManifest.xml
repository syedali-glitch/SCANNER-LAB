<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScannerLab"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="31">
        
        <!-- Disables ML Kit Telemetry for maximum privacy -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />
        <meta-data
            android:name="com.google.mlkit.analytics.DISABLE_STATS"
            android:value="true" />
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".QRScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".DocumentScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.scanner.lab.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".tools.SignatureActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.ScannerLab" />
            
        <activity
            android:name=".tools.PrivateSpaceActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ScannerLab" />
            
        <activity
            android:name=".PdfToolsActivity"
            android:exported="false"
            android:label="PDF Tools"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".ConverterActivity"
            android:exported="false"
            android:label="File Converter"
            android:screenOrientation="portrait" />
            
        <activity
            android:name=".FileViewerActivity"
            android:exported="false"
            android:label="File Viewer"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ScannerLab" />
            
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:label="Tools &amp; Engines"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.IntroActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ScannerLab" />

        <activity
            android:name=".tools.AnnotationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ScannerLab" />

        <activity
            android:name=".tools.HandwritingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ScannerLab" />

        <activity
            android:name=".tools.FingerRemovalActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ScannerLab" />
            
    </application>

</manifest>
