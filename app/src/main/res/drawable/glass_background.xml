<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer (Soft Diffuse) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp"> 
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#20000000" /> <!-- Extremely soft shadow -->
        </shape>
    </item>

    <!-- Glass Surface -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#D0FFFFFF" /> <!-- 80% opacity white/frosted -->
            <stroke android:width="1dp" android:color="#60FFFFFF" /> <!-- Glass edge -->
        </shape>
    </item>
    
    <!-- Top Highlight (Reflection) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient 
                android:startColor="#40FFFFFF" 
                android:endColor="#00FFFFFF" 
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
