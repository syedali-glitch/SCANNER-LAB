<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ref_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_play_arrow" 
            app:title="File Viewer"
            app:titleTextColor="@color/ref_text_primary" />
            
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <!-- Search Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/ref_card_bg"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_scan_doc"
                    app:tint="@color/ref_text_secondary"/>
                    
                <EditText
                    android:id="@+id/searchEt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Search files..."
                    android:textColor="@color/ref_text_primary"
                    android:textColorHint="@color/ref_text_secondary"
                    android:paddingStart="12dp"
                    android:inputType="text"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:background="@drawable/ref_chip_bg"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/white"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>
                    
                <TextView
                    android:id="@+id/chipPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:background="@drawable/ref_chip_bg"
                    android:textColor="@color/ref_text_secondary"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>
                    
                <TextView
                    android:id="@+id/chipDoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOC"
                    android:background="@drawable/ref_chip_bg"
                    android:textColor="@color/ref_text_secondary"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>
                    
                <TextView
                    android:id="@+id/chipXls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XLS"
                    android:background="@drawable/ref_chip_bg"
                    android:textColor="@color/ref_text_secondary"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
    </LinearLayout>
    
    <!-- FAB to pick file -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPickFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_upload"
        android:contentDescription="@string/select_file"
        app:elevation="6dp"
        app:pressedTranslationZ="12dp"
        app:tint="@color/obsidian_black"
        app:backgroundTint="@color/electric_sky" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
