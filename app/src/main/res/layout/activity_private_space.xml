<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ref_background">

    <!-- PIN Layout -->
    <LinearLayout
        android:id="@+id/pinLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/ref_accent"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvPinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter PIN"
            android:textColor="@color/ref_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/ref_surface_high"
            app:cardElevation="4dp"
            app:strokeColor="#33475569"
            app:strokeWidth="1dp"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/etPin"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:gravity="center"
                android:letterSpacing="0.5"
                android:textColor="@color/ref_text_primary"
                android:background="@null"
                android:padding="16dp"
                android:textSize="32sp"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="Unlock"
            app:cornerRadius="28dp"
            android:backgroundTint="@color/ref_accent"
            android:textColor="@color/ref_text_on_accent"/>

    </LinearLayout>

    <!-- Secure Content Layout -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ref_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/ref_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Private Space"
                android:textColor="@color/ref_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"/>

        </LinearLayout>

        <!-- Tool Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:padding="16dp">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Import File"
                app:icon="@drawable/ic_upload"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/ref_accent"/>
        </LinearLayout>

        <!-- List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            tools:itemCount="3"
            tools:listitem="@android:layout/simple_list_item_1"/>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vault is Empty\nTap '+ Import File' to hide photos/docs here."
            android:textColor="@color/ref_text_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
