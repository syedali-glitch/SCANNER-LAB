<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ref_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_play_arrow" 
            app:title="File Converter"
            app:titleTextColor="@color/ref_text_primary" />
            
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Format"
                android:textColor="@color/ref_text_primary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Convert files instantly with high accuracy"
                android:textColor="@color/ref_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Section: From Image -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From Image"
                android:textColor="@color/ref_text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="false">

                <!-- 1. Image to PDF -->
                <FrameLayout
                    android:id="@+id/cardImgToPdf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:id="@+id/iconImgToPdf"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pdf_tool"
                            app:tint="@color/ref_gradient_converter_start"
                            android:background="@drawable/ref_bg_converter"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Image to PDF"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 2. Image to Excel -->
                <FrameLayout
                    android:id="@+id/cardImgToExcel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_upload"
                            app:tint="@color/ref_gradient_converter_start"
                            android:background="@drawable/ref_bg_converter"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Image to Excel"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 3. Image to Word -->
                <FrameLayout
                    android:id="@+id/cardImgToWord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_scan_doc"
                            app:tint="@color/ref_gradient_converter_start"
                            android:background="@drawable/ref_bg_converter"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Image to Word"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>
            </GridLayout>

            <!-- Section: From PDF -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From PDF"
                android:textColor="@color/ref_text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="false">
                
                <!-- 4. PDF to Image -->
                <FrameLayout
                    android:id="@+id/cardPdfToImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_scan_doc"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF to Image"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 5. PDF to Text -->
                <FrameLayout
                    android:id="@+id/cardPdfToText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_scan_doc"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF to Text"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>
                
                 <!-- 6. PDF to Word (new) -->
                <FrameLayout
                    android:id="@+id/cardPdfToWord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_scan_doc"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF to Word"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

            </GridLayout>

            <!-- Progress Overlay -->
             <FrameLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:background="@drawable/ref_card_bg"
                android:padding="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <TextView
                        android:id="@+id/tvProgressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Converting..."
                        android:textColor="@color/ref_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>
                        
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/ref_gradient_converter_start"/>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
