<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/ref_surface_high"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="#33475569"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivToolIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_scan_doc"
            android:padding="10dp"
            android:background="@drawable/ref_bg_scanner"
            app:tint="@color/white"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvToolName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tool Name"
            android:textColor="@color/ref_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
