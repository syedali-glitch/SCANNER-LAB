<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ref_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_play_arrow" 
            app:title="PDF Tools"
            app:titleTextColor="@color/ref_text_primary" />
            
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage PDFs"
                android:textColor="@color/ref_text_primary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="8dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merge, Split, and Organize your documents"
                android:textColor="@color/ref_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Grid of Cards -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="true">

                <!-- 1. Merge PDF -->
                <FrameLayout
                    android:id="@+id/cardMerge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pdf_tool"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Merge PDFs"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 2. Split PDF -->
                <FrameLayout
                    android:id="@+id/cardSplit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pdf_tool"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Split PDF"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 3. Compress PDF -->
                <FrameLayout
                    android:id="@+id/cardCompress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pdf_tool"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compress"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 4. Watermark -->
                <FrameLayout
                    android:id="@+id/cardWatermark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_tool_pdf_watermark"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Watermark"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>
                
                <!-- 5. Password Protect -->
                <FrameLayout
                    android:id="@+id/cardPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_tool_pdf_password"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add Password"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- 6. Organize (Remove Pages) -->
                <FrameLayout
                    android:id="@+id/cardOrganize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pdf_tool"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Organize"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>
                <!-- 7. Edit PDF -->
                <FrameLayout
                    android:id="@+id/cardEditPdf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/ref_card_bg"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_nav_tools"
                            app:tint="@color/ref_gradient_tools_start"
                            android:background="@drawable/ref_bg_tools"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit PDF"
                            android:textColor="@color/ref_text_primary"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>
             
            </GridLayout>

            <!-- Progress Overlay -->
             <FrameLayout
                android:id="@+id/layoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:background="@drawable/ref_card_bg"
                android:padding="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <TextView
                        android:id="@+id/tvProgressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Processing..."
                        android:textColor="@color/ref_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>
                        
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/ref_gradient_tools_start"/>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
