<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_black"
    tools:context=".tools.AnnotationActivity">

    <!-- Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/deep_slate"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_scan_doc"
                app:tint="@color/silver_glow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Annotation &amp; Markup"
                android:textColor="@color/crisp_white"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVE"
                android:textColor="@color/obsidian_black"
                app:backgroundTint="@color/emerald_signal"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Canvas -->
    <com.scanner.lab.ui.AnnotationView
        android:id="@+id/annotationView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/toolbarContainer"/>

    <!-- Bottom Toolbar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/deep_slate"
        app:layout_constraintBottom_toBottomOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRedPen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red Pen"
                    android:textColor="@color/white"
                    app:backgroundTint="#F44336"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBluePen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blue Pen"
                    android:textColor="@color/white"
                    app:backgroundTint="#2196F3"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHighlighter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highlight"
                    android:textColor="@color/black"
                    app:backgroundTint="#FFEB3B"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEraser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eraser"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/midnight_grey"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/white"/>
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/electric_sky" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
