<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp"
            style="@style/TextHeadline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premium document scanner and converter"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"
            style="@style/TextBody" />

        <!-- QR Scanner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQrScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/GlassCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 QR Scanner"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    style="@style/TextTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan QR codes and barcodes instantly"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextBody" />

                <com.scanner.lab.ui.PremiumButton
                    android:id="@+id/btnQrScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_qr"
                    android:background="@drawable/button_premium_elevated"
                    android:textColor="@color/white"
                    style="@style/PremiumButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Document Scanner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDocScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/GlassCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 Document Scanner"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    style="@style/TextTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan and digitize documents with OCR"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextBody" />

                <com.scanner.lab.ui.PremiumButton
                    android:id="@+id/btnDocScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_document"
                    android:background="@drawable/button_premium_gradient"
                    android:textColor="@color/white"
                    style="@style/PremiumButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- File Converter Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConverter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/GlassCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 File Converter"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    style="@style/TextTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Convert between PDF, DOCX, PPTX, Images, and more"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextBody" />

                <com.scanner.lab.ui.PremiumButton
                    android:id="@+id/btnConverter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/file_converter"
                    android:background="@drawable/button_glass_morphism"
                    android:textColor="@color/primary"
                    style="@style/PremiumButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PDF Tools Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPdfTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/GlassCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛠️ PDF Tools"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    style="@style/TextTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Merge, split, compress, watermark, and protect PDFs"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextBody" />

                <com.scanner.lab.ui.PremiumButton
                    android:id="@+id/btnPdfTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pdf_tools"
                    android:background="@drawable/button_premium_elevated"
                    android:textColor="@color/white"
                    style="@style/PremiumButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Card (Initially Hidden) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            style="@style/GlassCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProgressTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/processing"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    style="@style/TextTitle" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    style="@style/TextBody" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AdMob Banner Ad -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

    </LinearLayout>
</ScrollView>
